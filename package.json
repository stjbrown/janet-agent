{
  "name": "janet-agent",
  "version": "0.1.0-beta.3",
  "description": "Janet builds and maintains portable LLM wikis in plain Markdown using OKF.",
  "keywords": [
    "agent",
    "agent-skills",
    "janet",
    "knowledge-base",
    "llm",
    "llm-wiki",
    "markdown",
    "okf"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/stjbrown/janet-agent.git"
  },
  "homepage": "https://github.com/stjbrown/janet-agent#readme",
  "bugs": {
    "url": "https://github.com/stjbrown/janet-agent/issues"
  },
  "publishConfig": {
    "access": "public"
  },
  "type": "module",
  "bin": {
    "janet": "dist/main.js"
  },
  "files": [
    "dist",
    "skills",
    "README.md",
    "OBSERVABILITY.md",
    "LICENSE",
    "NOTICE"
  ],
  "engines": {
    "node": ">=22.13.0"
  },
  "os": [
    "darwin"
  ],
  "scripts": {
    "sync:skills": "node scripts/sync-skills.mjs",
    "build": "pnpm sync:skills && tsup",
    "typecheck": "pnpm sync:skills && tsc --noEmit",
    "test": "pnpm sync:skills && vitest run",
    "verify": "pnpm build && pnpm typecheck && pnpm test",
    "prepack": "pnpm verify",
    "pack:janet": "pnpm verify && node scripts/pack-janet.mjs"
  },
  "dependencies": {
    "@ai-sdk/amazon-bedrock": "4.0.144",
    "@ai-sdk/anthropic": "3.0.104",
    "@ai-sdk/google-vertex": "4.0.174",
    "@ai-sdk/openai": "3.0.90",
    "@ai-sdk/openai-compatible": "2.0.63",
    "@aws-sdk/credential-providers": "3.1088.0",
    "@earendil-works/pi-tui": "0.80.6",
    "@mastra/core": "1.54.0",
    "@mastra/libsql": "1.18.0",
    "@mastra/memory": "1.24.0",
    "@mastra/observability": "1.16.3",
    "@mastra/otel-exporter": "1.3.6",
    "@mozilla/readability": "0.6.0",
    "@opentelemetry/exporter-trace-otlp-proto": "0.218.0",
    "ai": "6.0.238",
    "chalk": "5.6.2",
    "ipaddr.js": "2.4.0",
    "jsdom": "29.1.1",
    "pdf-parse": "2.4.5",
    "strip-ansi": "7.2.0",
    "turndown": "7.2.4",
    "undici": "7.29.0",
    "yaml": "2.9.0",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@stjbrown/agent-knowledge-skills": "0.2.0",
    "@types/jsdom": "28.0.3",
    "@types/node": "^22.20.1",
    "@types/turndown": "5.0.6",
    "tsup": "^8.3.0",
    "tsx": "^4.19.0",
    "typescript": "^5.6.0",
    "vitest": "^2.1.0"
  },
  "packageManager": "pnpm@11.13.1"
}
